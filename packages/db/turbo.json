{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // build runs `prisma generate --generator client` first
      "outputs": ["dist/**", "src/generated/**"]
    },
    "check-types": {
      "dependsOn": ["build"]
    },
    "lint": {
      "dependsOn": ["build"]
    }
  }
}
