generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum Side {
  BRIDE
  GROOM
  BOTH
}

enum RsvpStatus {
  PENDING
  ATTENDING
  DECLINED
  MAYBE
}

enum ModerationStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum GiftMethod {
  CASH
  BANK_TRANSFER
  GOLD
  OTHER
}

/// Where a gift record came from
enum GiftSource {
  MANUAL
  PAYOS
}

enum PayosStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum Relation {
  FAMILY
  RELATIVE
  FRIEND
  COLLEAGUE
  NEIGHBOR
  OTHER
}

enum PlanCategory {
  VENUE
  FOOD
  ATTIRE
  PHOTO
  DECOR
  CEREMONY
  INVITATION
  RINGS
  BEAUTY
  ENTERTAINMENT
  TRANSPORT
  GIFTS
  PAPERWORK
  HONEYMOON
  OTHER
}

model WeddingInfo {
  id            Int      @id @default(1)
  brideName     String
  groomName     String
  brideParents  String?
  groomParents  String?
  weddingDate   DateTime
  story         String?  @db.Text
  coverPhotoKey String?
  /// Total wedding budget target, VND
  budget        BigInt?
  updatedAt     DateTime @updatedAt
}

model Event {
  id          String            @id @default(uuid(7)) @db.Char(36)
  name        String
  side        Side
  /// Days from WeddingInfo.weddingDate (0 = the wedding day, -1 = the day before)
  dayOffset   Int               @default(0)
  /// Vietnam wall-clock time, HH:mm
  startTime   String            @default("00:00") @db.Char(5)
  endTime     String?           @db.Char(5)
  /// Derived from weddingDate + dayOffset + startTime/endTime; never set directly
  startAt     DateTime
  endAt       DateTime?
  venueName   String
  address     String
  mapUrl      String?           @db.Text
  sortOrder   Int               @default(0)
  tables      Table[]
  invitations InvitationEvent[]
  gifts       Gift[]
}

model Invitation {
  id        String            @id @default(uuid(7)) @db.Char(36)
  code      String            @unique @db.VarChar(16)
  name      String
  side      Side
  relation  Relation          @default(OTHER)
  maxGuests Int               @default(1)
  phone     String?
  note      String?           @db.Text
  openedAt  DateTime?
  createdAt DateTime          @default(now())
  guests    Guest[]
  events    InvitationEvent[]
  guestbook GuestbookEntry[]
  gifts     Gift[]
  photos    Photo[]
  payments  PayosPayment[]

  @@index([side])
}

model Guest {
  id           String     @id @default(uuid(7)) @db.Char(36)
  invitationId String     @db.Char(36)
  name         String
  isChild      Boolean    @default(false)
  dietaryNote  String?
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

model InvitationEvent {
  invitationId   String     @db.Char(36)
  eventId        String     @db.Char(36)
  status         RsvpStatus @default(PENDING)
  attendingCount Int        @default(0)
  message        String?    @db.Text
  respondedAt    DateTime?
  tableId        String?    @db.Char(36)
  invitation     Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  event          Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  table          Table?     @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@id([invitationId, eventId])
  @@index([eventId, status])
  @@index([tableId])
}

model Table {
  id       String            @id @default(uuid(7)) @db.Char(36)
  eventId  String            @db.Char(36)
  name     String
  capacity Int               @default(10)
  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seats    InvitationEvent[]

  @@unique([eventId, name])
}

model Album {
  id        String  @id @default(uuid(7)) @db.Char(36)
  title     String
  isGuest   Boolean @default(false)
  sortOrder Int     @default(0)
  photos    Photo[]
}

model Photo {
  id           String           @id @default(uuid(7)) @db.Char(36)
  albumId      String?          @db.Char(36)
  objectKey    String           @unique
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  caption      String?
  status       ModerationStatus @default(PENDING)
  invitationId String?          @db.Char(36)
  createdAt    DateTime         @default(now())
  album        Album?           @relation(fields: [albumId], references: [id], onDelete: SetNull)
  invitation   Invitation?      @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([albumId, status])
  @@index([invitationId])
}

model GuestbookEntry {
  id           String           @id @default(uuid(7)) @db.Char(36)
  invitationId String?          @db.Char(36)
  authorName   String
  message      String           @db.Text
  status       ModerationStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  invitation   Invitation?      @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([invitationId])
}

model Gift {
  id           String      @id @default(uuid(7)) @db.Char(36)
  invitationId String?     @db.Char(36)
  eventId      String?     @db.Char(36)
  giverName    String
  method       GiftMethod
  amount       BigInt?
  description  String?
  /// Which family received it (null for old manual records)
  side         Side?
  source       GiftSource    @default(MANUAL)
  /// Wish left by the guest with an online gift
  message      String?       @db.Text
  receivedAt   DateTime      @default(now())
  invitation   Invitation?   @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  payment      PayosPayment?

  @@index([invitationId])
  @@index([eventId])
}

/// payOS merchant credentials, one channel (bank account) per family.
/// Keys are AES-256-GCM encrypted with SETTINGS_SECRET; never sent to clients.
model PayosConfig {
  side           Side     @id
  clientId       String
  apiKeyEnc      String   @db.Text
  checksumKeyEnc String   @db.Text
  enabled        Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

/// A payOS payment link created for an online gift; becomes a Gift once paid
model PayosPayment {
  id                 String      @id @default(uuid(7)) @db.Char(36)
  orderCode          BigInt      @unique
  /// payOS channel (one per family)
  side               Side
  amount             BigInt
  giverName          String
  message            String?     @db.Text
  invitationId       String?     @db.Char(36)
  status             PayosStatus @default(PENDING)
  paymentLinkId      String      @unique
  qrCode             String      @db.Text
  checkoutUrl        String      @db.Text
  bin                String      @db.VarChar(8)
  accountNumber      String
  accountName        String
  description        String
  expiresAt          DateTime
  /// Last time the status was asked from payOS (throttles polling)
  checkedAt          DateTime?
  paidAt             DateTime?
  reference          String?
  counterAccountName String?
  giftId             String?     @unique @db.Char(36)
  createdAt          DateTime    @default(now())
  invitation         Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  gift               Gift?       @relation(fields: [giftId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([invitationId])
}

model AdminUser {
  id           String   @id @default(uuid(7)) @db.Char(36)
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// A planned wedding cost; what was actually paid lives in its payments
model Expense {
  id        String           @id @default(uuid(7)) @db.Char(36)
  category  PlanCategory
  name      String
  vendor    String?
  /// Expected cost, VND
  estimated BigInt           @default(0)
  /// Who pays for it
  side      Side             @default(BOTH)
  dueDate   DateTime?
  note      String?          @db.Text
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  payments  ExpensePayment[]
  tasks     Task[]

  @@index([category])
}

/// Deposit, instalment or final payment of an expense
model ExpensePayment {
  id        String   @id @default(uuid(7)) @db.Char(36)
  expenseId String   @db.Char(36)
  amount    BigInt
  paidAt    DateTime @default(now())
  note      String?
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

/// Wedding to-do item
model Task {
  id        String       @id @default(uuid(7)) @db.Char(36)
  title     String
  category  PlanCategory @default(OTHER)
  dueDate   DateTime?
  doneAt    DateTime?
  /// Who takes care of it (null = not assigned)
  assignee  Side?
  note      String?      @db.Text
  expenseId String?      @db.Char(36)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  expense   Expense?     @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([dueDate])
  @@index([expenseId])
}
