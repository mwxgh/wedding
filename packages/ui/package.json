    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "gsap": "3.15.0",
    "lucide-react": "1.54.0",
    "motion": "12.43.0",
    "next-themes": "0.4.6",
    "ogl": "1.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8"
