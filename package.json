{
  "name": "wedding",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,css,json,md}\"",
    "dev:api": "turbo run dev --filter=api",
    "dev:web": "turbo run dev --filter=web",
    "start:api": "pnpm --filter api start",
    "start:web": "pnpm --filter web start",
    "infra": "docker compose -f deploy/docker-compose.yml --env-file deploy/.env",
    "infra:up": "pnpm infra up -d",
    "infra:down": "pnpm infra down",
    "infra:stop": "pnpm infra stop",
    "infra:ps": "pnpm infra ps",
    "infra:logs": "pnpm infra logs -f --tail=100",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:types": "pnpm --filter @repo/db db:types",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:deploy": "pnpm --filter @repo/db db:deploy",
    "db:check": "pnpm --filter @repo/db db:check",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "db:seed:demo": "pnpm --filter @repo/db db:seed:demo",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "prettier-plugin-classnames": "0.10.4",
    "prettier-plugin-merge": "0.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
