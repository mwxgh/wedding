PORT=3001
# Comma-separated origins allowed by CORS
WEB_ORIGIN=http://localhost:3000

# PostgreSQL (see deploy/.env); one schema per app on a shared user/database
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/postgres?schema=wedding

# Admin auth
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=7d

# RustFS / S3 (see deploy/.env)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me-access
S3_SECRET_KEY=change-me-secret
S3_BUCKET=wedding
# Max upload size per photo (MB)
UPLOAD_MAX_MB=15

# Public site URL (payOS returns guests here after checkout)
PUBLIC_SITE_URL=http://localhost:3000

# Encrypts secrets saved from the admin (payOS keys). Generate once, e.g.
#   openssl rand -base64 32
# Changing it means re-entering those keys in Cài đặt.
SETTINGS_SECRET=change-me-long-random-string

# Minutes a gift QR stays valid
PAYOS_TTL_MINUTES=15
