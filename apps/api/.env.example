PORT=3001
# Comma-separated origins allowed by CORS
WEB_ORIGIN=http://localhost:3000

# MySQL (see deploy/.env)
DATABASE_URL=mysql://app:change-me@127.0.0.1:3306/app

# Admin auth
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=7d

# RustFS / S3 (see deploy/.env)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me-access
S3_SECRET_KEY=change-me-secret
S3_BUCKET=wedding
# Max upload size per photo (MB)
UPLOAD_MAX_MB=15
