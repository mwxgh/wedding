TZ=Asia/Ho_Chi_Minh

# Restart policy for all services
#   dev:  no              (only start on `docker compose up -d`)
#   prod: unless-stopped  (auto start after reboot/crash, unless stopped manually)
RESTART_POLICY=no

# PostgreSQL – one user/database shared by apps, each app in its own schema
POSTGRES_VERSION=17-alpine
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Redis
REDIS_VERSION=7.4-alpine
REDIS_BIND=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# RustFS (S3-compatible)
RUSTFS_VERSION=latest
RUSTFS_BIND=127.0.0.1
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ACCESS_KEY=change-me-access
RUSTFS_SECRET_KEY=change-me-secret-min-8-chars
