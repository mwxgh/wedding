# Production settings for docker-compose.prod.yml. Generate secrets with
#   openssl rand -hex 24
DOMAIN=example.com
# Images: local builds use `wedding`; CI pushes to ghcr.io/<owner>/<repo>
IMAGE_PREFIX=wedding
TAG=latest

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=wedding
MYSQL_USER=wedding
MYSQL_PASSWORD=change-me

RUSTFS_ACCESS_KEY=change-me-access
RUSTFS_SECRET_KEY=change-me-secret-min-8-chars

JWT_SECRET=change-me-long-random-string
# Encrypts payOS keys saved from the admin. Changing it means re-entering them.
SETTINGS_SECRET=change-me-long-random-string
