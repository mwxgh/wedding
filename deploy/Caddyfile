{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

api.{$DOMAIN} {
	# Server-sent events: no compression, flush every event straight away
	@stream path /public/guestbook/stream
	handle @stream {
		reverse_proxy api:3001 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		request_body {
			max_size 20MB
		}
		reverse_proxy api:3001
	}
}

s3.{$DOMAIN} {
	reverse_proxy rustfs:9000
}
